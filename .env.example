# ---------------------------------------------------------------------------
# Fleet pipeline configuration. Copy to .env before `make up`.
# Every value here is read by common/config.py; nothing is hard-coded in apps.
# ---------------------------------------------------------------------------

# --- Simulated clock (SPEC §3) --------------------------------------------
# 1 real second == COMPRESSION simulated seconds.
# 60 => 1 real minute is 1 simulated hour, 24 real minutes is 1 simulated day.
COMPRESSION=60
# A Monday 06:00 UTC, so the morning demand peak arrives within ~1 real minute.
SIM_EPOCH=2024-01-01T06:00:00Z
SHARED_DIR=/shared

# --- Storage ---------------------------------------------------------------
LAKE_ROOT=/lake
LANDING_DIR=/landing
REPORTS_DIR=/reports

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side port for psql/Grafana-from-the-laptop. Changed from 5432 because a
# local PostgreSQL install very commonly already owns that port.
POSTGRES_HOST_PORT=55432
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet_dev_pw
# Airflow keeps its metadata in a separate database on the same server.
AIRFLOW_DB=airflow

# --- Kafka -----------------------------------------------------------------
KAFKA_BOOTSTRAP=kafka:9092
TELEMETRY_TOPIC=fleet.telemetry
DLQ_TOPIC=fleet.telemetry.dlq
TELEMETRY_PARTITIONS=6
TELEMETRY_RETENTION_MS=604800000

# --- City and zones (SPEC §5.1) -------------------------------------------
CITY_LAT_MIN=12.90
CITY_LAT_MAX=13.06
CITY_LON_MIN=77.52
CITY_LON_MAX=77.68
ZONE_ROWS=4
ZONE_COLS=4

# --- Fleet / telemetry simulator ------------------------------------------
N_VEHICLES=50
N_LEMONS=5
EMIT_INTERVAL_REAL_S=2
SIM_SEED=20240101
TELEMETRY_CONTROL_PORT=8010
TELEMETRY_METRICS_PORT=8001

# Fault-injection rates (SPEC §5.1). Fractions of emitted events.
FAULT_MALFORMED_RATE=0.005
FAULT_INVALID_RATE=0.005
FAULT_DUPLICATE_RATE=0.01
FAULT_LATE_RATE=0.02
FAULT_LATE_MIN_SIM_MIN=1
FAULT_LATE_MAX_SIM_MIN=20

# --- Fares (currency units) ------------------------------------------------
CURRENCY_LABEL=CU
FARE_BASE=30.0
FARE_PER_KM=12.0
FARE_PER_MIN=1.5

# --- Expense dropper -------------------------------------------------------
EXPENSE_DELAY_SIM_MIN=60
EXPENSE_LATE_FILE_RATE=0.05
EXPENSE_BAD_ROW_RATE=0.04
EXPENSE_DISTANCE_DISCREPANCY_RATE=0.03
FUEL_PRICE_PER_LITRE=105.0
EXPENSE_CONTROL_PORT=8011
EXPENSE_METRICS_PORT=8002

# --- Speed layer (SPEC §7) -------------------------------------------------
# All thresholds are in SIMULATED minutes and converted by common/simclock.py.
WATERMARK_SIM_MIN=10
IDLE_ALERT_SIM_MIN=45
OFFLINE_SIM_MIN=20
ARCHIVER_TRIGGER_REAL_S=30
SPEED_TRIGGER_REAL_S=5
SPARK_MASTER_URL=spark://spark-master:7077
# Host-side port for the Spark worker UI (8081 is commonly taken).
SPARK_WORKER_UI_PORT=8181
SPEED_METRICS_PORT=8003
ARCHIVER_METRICS_PORT=8004

# --- Batch layer (SPEC §8) -------------------------------------------------
LATE_GRACE_SIM_MIN=30
EXPENSE_SLA_SIM_MIN=120
MARGIN_THRESHOLD=0.10
DISTANCE_MISMATCH_THRESHOLD=0.15
MAX_INVALID_EXPENSE_PCT=0.20
# Physically impossible GPS jump filter for gps_km (km/h).
MAX_PLAUSIBLE_SPEED_KMH=150

# --- Serving ---------------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO
# 1 in N per-event log lines (SPEC §10.1: do not log every event).
LOG_SAMPLE_EVERY=500

# --- Airflow ---------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=ZmRzYWZkc2FmZHNhZmRzYWZkc2FmZHNhZmRzYWZkcz0=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
