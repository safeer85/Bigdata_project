__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
lake/
checkpoints/
shared/
reports/*.html
reports/*.csv
landing/
*.log
.DS_Store
.idea/
.vscode/

# LaTeX build products. The source in docs/report/ is tracked; everything
# pdflatex and bibtex generate from it is not. (*.log is already covered above.)
docs/report/*.aux
docs/report/*.bbl
docs/report/*.blg
docs/report/*.lof
docs/report/*.lot
docs/report/*.out
docs/report/*.toc
docs/report/*.fls
docs/report/*.fdb_latexmk
docs/report/*.synctex.gz
# The build copy. The tracked artefact is docs/report.pdf, one level up.
docs/report/report.pdf

# The submitted report is a deliverable and IS tracked.
!docs/report.pdf
